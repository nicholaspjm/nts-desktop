{
	"name": "nts-desktop",
	"version": "0.7.1",
	"description": "A desktop app for playing NTS Live and streams",
	"type": "module",
	"main": "index.cjs",
	"author": "Romeo Van Snick <romeo@romeovansnick.be>",
	"license": "MIT",
	"repository": "https://github.com/nicholaspjm/nts-desktop",
	"scripts": {
		"build": "node scripts/build.mjs",
		"start": "npm run build && electron dist",
		"dist": "npm run build && electron-builder build --win --publish=never",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"format:check": "biome check . --linter-enabled=false --organize-imports-enabled=true",
		"format": "biome check . --linter-enabled=false --organize-imports-enabled=true --fix"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["@biomejs/biome", "electron", "esbuild"]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@electron/notarize": "^3.1.1",
		"@types/classnames": "^2.3.4",
		"@types/isomorphic-fetch": "^0.0.35",
		"@types/node": "^22.8.7",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/react-transition-group": "^4.4.11",
		"@vitejs/plugin-react": "^5.2.0",
		"concurrently": "^6.5.1",
		"dotenv-cli": "^7.4.2",
		"electron": "^43.4.0",
		"electron-builder": "^24.13.3",
		"esbuild": "^0.28.2",
		"json": "^11.0.0",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^10.0.9",
		"typescript": "5",
		"typescript-plugin-css-modules": "^3.4.0",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.0.1"
	},
	"dependencies": {
		"bonjour-service": "^1.4.4",
		"bplist-parser": "^0.3.2",
		"castv2": "^0.1.10",
		"classnames": "^2.5.1",
		"electron-log": "^4.4.8",
		"electron-serve": "^1.3.0",
		"firebase": "^11.0.1",
		"hls.js": "^1.7.0",
		"isomorphic-fetch": "^3.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-transition-group": "^4.4.5"
	}
}
