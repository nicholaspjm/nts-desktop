node-linker=hoisted

# Native bindings (rolldown, esbuild) are platform specific. Without this the
# lockfile only records the platform it was generated on, so CI on Linux and any
# future macOS build cannot resolve their own binaries.
supported-architectures.os[]=win32
supported-architectures.os[]=linux
supported-architectures.os[]=darwin
supported-architectures.cpu[]=x64
supported-architectures.cpu[]=arm64
