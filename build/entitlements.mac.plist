<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Notarisation requires the hardened runtime, and the hardened runtime blocks
	  things Electron cannot run without. V8 compiles JavaScript at runtime, which
	  needs both of the first two. The Electron framework is loaded from inside the
	  bundle rather than the system, which needs the last one.

	  Nothing here grants access to the microphone, camera, contacts, location or
	  the filesystem outside the app. This is a radio player and asks for no such
	  thing.
	-->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
